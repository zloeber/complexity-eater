  "cards": [
    {
      "dot": "cyan",
      "title": "Listeners",
      "items": [
        "GET / on the owner port sets commonroom_session, HttpOnly and SameSite=Strict",
        "POST /mcp is mounted only on the session ingress",
        "A non-loopback bind is refused. Tailcat may publish the ingress, not the owner port"
      ]
    },
    {
      "dot": "amber",
      "title": "Approval",
      "items": [
        "The host session holds every capability, including approve",
        "A default invitation grants read, observe, propose, checkout, and commit",
        "An approved proposal can be committed. A raw overwrite requires admin"
      ]
    },
    {
      "dot": "emerald",
      "title": "Substrate",
      "items": [
        "The engine is the only writer of the markdown file and the sidecar",
        "An external edit of the markdown file becomes a new version",
        "Invitations use the commonroom://join/ protocol"
      ]
    }
  ]
